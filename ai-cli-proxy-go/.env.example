# Gemini CLI OAuth credentials (from the gemini-cli-core npm package).
# Required for token refresh when the credentials file does not contain
# client_id / client_secret (which is the case for tokens generated by
# the gemini-cli OAuth flow).
GEMINI_CLI_OAUTH_CLIENT_ID=
GEMINI_CLI_OAUTH_CLIENT_SECRET=

# Optional: override client credentials for the Antigravity provider.
# Falls back to GEMINI_CLI_OAUTH_CLIENT_ID / GEMINI_CLI_OAUTH_CLIENT_SECRET if unset.
# GEMINI_ANTIGRAVITY_OAUTH_CLIENT_ID=
# GEMINI_ANTIGRAVITY_OAUTH_CLIENT_SECRET=
